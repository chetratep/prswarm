{
  "name": "prdispatch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' --if-present lint",
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

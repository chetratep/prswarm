{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter", "@prswarm/web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter", "@prswarm/api", "dev"],
      "port": 4000
    },
    {
      "name": "docs",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd website && bun run start"],
      "port": 3000
    }
  ]
}

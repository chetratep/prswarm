# --- Server ---
PORT=3000
DATABASE_PATH=./data/app.db

# --- Secrets ---
# 32-byte key (64-char hex, or base64) used to encrypt the stored GitHub PAT
# at rest via AES-256-GCM. Separate from SESSION_SECRET below, which only
# signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Instance login (optional) ---
# Off by default — fine for local/localhost use. Turn on if this instance is
# ever reachable past localhost. See CLAUDE.md > Instance login.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# --- Notifications (optional) ---
# Slack incoming-webhook URL. Leave unset to skip notifications entirely —
# job completion never blocks on this either way.
SLACK_WEBHOOK_URL=

# --- Server ---
# The API's own bind port — also what the web dev server's proxy targets.
API_PORT=3000
# The web dev server's own bind port. Rarely needs changing.
VITE_PORT=5173
# Defaults to an OS-appropriate per-user data directory if unset (see
# apps/api/src/paths.ts) — set this explicitly for local dev to keep the
# database inside the repo checkout instead.
DATABASE_PATH=./data/app.db

# --- Secrets ---
# 32-byte key (64-char hex, or base64) used to encrypt the stored GitHub PAT
# and the database file itself at rest via AES-256-GCM. On a desktop OS
# (Windows/macOS), this is optional — the app stores an auto-generated key
# in the OS keychain instead, with no plaintext key file. On a headless
# Linux server or inside Docker, there is no keychain to use: the key either
# comes from this env var (recommended — supply it via your deployment
# platform's own secret mechanism, e.g. a Docker secret or Kubernetes
# secret) or an auto-generated key file is used, which sits in the same
# data directory as the encrypted database it protects. Separate from
# SESSION_SECRET below, which only signs the login cookie.
# Set explicitly with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Instance login (optional) ---
# Off by default — fine for local/localhost use. Turn on if this instance is
# ever reachable past localhost. See CLAUDE.md > Instance login.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# --- Notifications (optional) ---
# Slack incoming-webhook URL. Leave unset to skip notifications entirely —
# job completion never blocks on this either way.
SLACK_WEBHOOK_URL=
